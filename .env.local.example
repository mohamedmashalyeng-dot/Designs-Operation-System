# ─────────────────────────────────────────────────────────────────────────
# Supabase (required)
# Create a project at https://supabase.com/dashboard, then copy these from
# Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# AI providers (optional in development — the app falls back to a clearly
# labeled mock provider when a key is missing, so the workflow is testable
# end-to-end without live credentials)
# ─────────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which provider each AI capability should use. Defaults to "mock" when
# unset or when the matching API key above is missing.
AI_LLM_PROVIDER=openai
AI_IMAGE_PROVIDER=openai

# Optional model overrides — verify current ids at
# developers.openai.com/api/docs/models before changing (the lineup moves
# quickly; defaults below were current as of 2026-09).
# OPENAI_LLM_MODEL=gpt-5.6-terra
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=high

# ─────────────────────────────────────────────────────────────────────────
# Canva (optional — Connect API, server-side only)
# Register an integration at https://www.canva.com/developers/
# NOT CONNECTED until these are set — see src/lib/canva/README.md
# ─────────────────────────────────────────────────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/connections/canva/callback

# ─────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────
# Dev-only auth bypass (optional). Set BYPASS_AUTH=true to skip the login
# screen locally — the proxy transparently signs you into one real,
# auto-provisioned Supabase account (see src/lib/dev/ensure-dev-session.ts)
# so Server Actions and RLS work normally, no special-casing anywhere else.
# Guarded to NODE_ENV !== "production" so it can never activate in a real
# deployment. DEV_BYPASS_EMAIL/PASSWORD are optional overrides — safe
# defaults are baked in since this account only ever lives in a dev project.
# ─────────────────────────────────────────────────────────────────────────
# BYPASS_AUTH=true
# DEV_BYPASS_EMAIL=dev-bypass@creative-ops.local
# DEV_BYPASS_PASSWORD=
