# ─────────────────────────────────────────────────────────────────────────
# Supabase (required)
# Create a project at https://supabase.com/dashboard, then copy these from
# Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# AI providers (optional in development — the app falls back to a clearly
# labeled mock provider when a key is missing, so the workflow is testable
# end-to-end without live credentials)
# ─────────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which provider each AI capability should use. Defaults to "mock" when
# unset or when the matching API key above is missing.
AI_LLM_PROVIDER=openai
AI_IMAGE_PROVIDER=openai

# Optional model overrides — verify current ids at
# developers.openai.com/api/docs/models before changing (the lineup moves
# quickly; defaults below were current as of 2026-09).
# OPENAI_LLM_MODEL=gpt-5.6-terra
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=high

# ─────────────────────────────────────────────────────────────────────────
# Canva (optional — Connect API, server-side only)
# Register an integration at https://www.canva.com/developers/
# NOT CONNECTED until these are set — see src/lib/canva/README.md
# ─────────────────────────────────────────────────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Canva requires 127.0.0.1 for local redirects. Open the app using the same host.
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/connections/canva/callback

# ─────────────────────────────────────────────────────────────────────────
# LinkedIn (optional — Posts API, server-side only)
# Register an app at https://www.linkedin.com/developers/apps and request
# the "Share on LinkedIn" product (self-serve, no review). Only posts to
# the connecting member's own profile — Company Pages need a separate,
# non-self-serve LinkedIn review. NOT CONNECTED until these are set.
# ─────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:3000/api/connections/linkedin/callback
# Optional override — LinkedIn requires a "YYYYMM" version header that
# rolls forward monthly; re-check developer.linkedin.com if calls fail.
# LINKEDIN_API_VERSION=202509

# ─────────────────────────────────────────────────────────────────────────
# Meta / Facebook & Instagram (optional — Graph API, server-side only)
# Register an app at https://developers.facebook.com/apps. Real posting
# permissions require Business Verification + App Review (multi-week,
# not self-serve) — until then this only works for accounts added as an
# Admin/Developer/Tester on your app. NOT CONNECTED until these are set.
# ─────────────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:3000/api/connections/meta/callback
# META_GRAPH_API_VERSION=v25.0

# ─────────────────────────────────────────────────────────────────────────
# Scheduled publishing (optional). Protects
# /api/cron/publish-scheduled — point a real scheduler (Vercel Cron, a
# Supabase scheduled Edge Function, etc.) at that URL with this as a
# Bearer token; nothing fires it on its own otherwise.
# ─────────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────────────
# Dev-only auth bypass (optional). Set BYPASS_AUTH=true to skip the login
# screen locally — the proxy transparently signs you into one real,
# auto-provisioned Supabase account (see src/lib/dev/ensure-dev-session.ts)
# so Server Actions and RLS work normally, no special-casing anywhere else.
# Guarded to NODE_ENV !== "production" so it can never activate in a real
# deployment. DEV_BYPASS_EMAIL/PASSWORD are optional overrides — safe
# defaults are baked in since this account only ever lives in a dev project.
# ─────────────────────────────────────────────────────────────────────────
# BYPASS_AUTH=true
# DEV_BYPASS_EMAIL=dev-bypass@creative-ops.local
# DEV_BYPASS_PASSWORD=
